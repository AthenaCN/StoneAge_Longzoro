							--NLG.TalkToCli(_TalkIndex,"扣除会员点100！");
							NLG.TalkToCli(_TalkIndex,"形象转换成功！");
							NLG.UpChar( TM_MyPetIndex);
							return;
						end
					end
				end
			end
		end

		if _Data == "1" then
			local selectPet = _Seqno - 5;
			local TM_MyPetIndex = Char.GetPetIndex(_TalkIndex,selectPet);
			if TM_MyPetIndex <0 then
				return;
			end
			local TM_MyPetId = Char.GetData(TM_MyPetIndex,%对像_形象%);
			if TM_MyPetId >= 0 then
				local i;
				for i=1,TM_PetMaxNum do
					if TM_MyPetId == TM_PetId[i] then
						local TM_MyPet4v = PetUp_4v(TM_MyPetIndex);
						local TM_PayVipPoint = (TM_Pet4v[i]-TM_MyPet4v)*50;
						if TM_PayVipPoint < 0 then
							return;
						end
						local TM_MyVipPoint = Char.GetData(_TalkIndex,%对像_声望%);
						if TM_MyVipPoint < TM_PayVipPoint then
							NLG.TalkToCli(_TalkIndex,"您的会员点不够！");
							return;
						end
						--Char.VipPoint(_TalkIndex,-TM_PayVipPoint,1);
					--	NLG.TalkToCli(_TalkIndex,"扣除会员点"..TM_PayVipPoint.."！");

						Char.SetData(TM_MyPetIndex,%对象_LUA%,1);
						PetUp_WindowTalked(_MeIndex, _TalkIndex, _Seqno, 1, "");
						return;
					end
				end
			end
		end
	end

end

function PetUp_4v(petindex)
	local TM_PetHP,TM_PetStr,TM_PetTough,TM_PetDex;
	TM_PetHP = (Char.GetData(petindex,%对像_体力%)*4 + Char.GetData(petindex,%对像_腕力%) + Char.GetData(petindex,%对像_耐力%) + Char.GetData(petindex,%对像_速度%)) * 0.01;
	TM_PetStr = Char.GetData(petindex,%对像_腕力%)*0.01 + Char.GetData(petindex,%对像_耐力%)*0.01*0.1 + Char.GetData(petindex,%对像_体力%)*0.01*0.1 + Char.GetData(petindex,%对像_速度%)*0.01*0.05;
	TM_PetTough = Char.GetData(petindex,%对像_耐力%)*0.01 + Char.GetData(petindex,%对像_腕力%)*0.01*0.1 + Char.GetData(petindex,%对像_体力%)*0.01*0.1 + Char.GetData(petindex,%对像_速度%)*0.01*0.05;
	TM_PetDex = Char.GetData(petindex,%对像_速度%)*0.01;
	local TM_PetResault = TM_PetStr + TM_PetTough + TM_PetDex + TM_PetHP*0.25;
	return math.ceil(TM_PetResault);
end


