function PetUp_Init( _MeIndex )
	Char.SetData(_MeIndex, %对像_形象%, 100000);
	Char.SetData(_MeIndex, %对像_原形%, 100000);
	Char.SetData(_MeIndex, %对像_地图%, 2000);
	Char.SetData(_MeIndex, %对像_X%, 51);
	Char.SetData(_MeIndex, %对像_Y%, 83);
	Char.SetData(_MeIndex, %对像_方向%, %右下%);
	Char.SetData(_MeIndex, %对像_原名%, "宠物进化大师");

	if (Char.SetTalkedEvent(nil, "PetUp_Talked", _MeIndex) < 0) then
		print("EquipPlus_Talked 注册事件失败。");
		return false;
	end
	if (Char.SetWindowTalkedEvent(nil, "PetUp_WindowTalked", _MeIndex) < 0) then
		print("pztestnpc_WindowTalked 注册事件失败。");
		return false;
	end

	return true;
end

